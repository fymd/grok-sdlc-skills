/* pages/index/index.wxss */
.container {
  padding: 24rpx;
}

.add-bar {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.add-input {
  flex: 1;
  height: 64rpx;
  padding: 0 20rpx;
  font-size: 30rpx;
}

.add-btn {
  margin-left: 16rpx;
}

.empty {
  margin-top: 120rpx;
  text-align: center;
  color: #999;
  font-size: 28rpx;
}

.list {
  margin-top: 24rpx;
}

.item {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.check {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  border: 2rpx solid #07c160;
  border-radius: 50%;
  color: #07c160;
  margin-right: 20rpx;
  font-size: 28rpx;
}

.title {
  flex: 1;
  font-size: 30rpx;
}

.item.done .title {
  color: #aaa;
  text-decoration: line-through;
}

.item.done .check {
  background: #07c160;
  color: #fff;
}

.del {
  color: #e54d42;
  font-size: 26rpx;
  padding: 8rpx 16rpx;
}
